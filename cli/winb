          f"  sample {track.get('sampleSec')}s"
          + (f"  DEGRADED: {track['degraded'].get('reason')}" if track.get("degraded") else ""))
    if "--full" in args:
        if apps.get("windows"):
            print("\nwindows:")
            for w in apps["windows"]:
                print(f"  {w.get('app'):<24} {w.get('cpuSec') or 0:>9}s  {str(w.get('title') or '')[:70]}")
        if apps.get("recent"):
            print("\nrecent foreground:")
            for r in apps["recent"][-15:]:
                print(f"  {_clock(r.get('t'))}  {r.get('app'):<22} {str(r.get('title') or '')[:60]}")
    return 0


