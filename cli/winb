def parse(argv):
    """Hand-rolled parser mirroring v1: flags anywhere, everything else is the command."""
    opts = {"command_parts": []}
    value_flags = {"-w": "workdir", "--workdir": "workdir", "-id": "process_id",
                   "--process-id": "process_id", "--logs": "logs", "--tail": "tail",
                   "--open-url": "open_url", "--port": "port", "-k": "kill", "--kill": "kill",
                   "-e": "env", "--env": "env", "-t": "timeout", "--timeout": "timeout",
                   "--stdin-file": "stdin_file", "--cmd-file": "cmd_file", "--out": "out",
                   "--server": "server", "--client-timeout": "client_timeout",
                   "--session": "session", "-s": "session", "--path": "path", "--length": "length",
                   "--offset": "offset"}
    bool_flags = {"-b": "background", "--background": "background", "-l": "list", "--list": "list",
                  "--health": "health", "-p": "powershell", "--powershell": "powershell",
                  "--raw": "raw", "--admin": "admin", "--json": "json", "--quiet": "quiet",
                  "--version": "version", "--manifest": "manifest", "--recursive": "recursive",
                  "-h": "help", "--help": "help"}

    def coerce(name, value):
        if name in ("timeout", "client_timeout", "tail", "length", "offset"):
            try:
                return int(value)
            except ValueError:
                die(f"{name} must be an integer, got {value!r}")
        return value

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in value_flags:
            if i + 1 >= len(argv):
                die(f"{arg} needs a value")
            name = value_flags[arg]
            value = coerce(name, argv[i + 1])
            if name == "env":
                opts.setdefault("env", []).append(value)
            else:
                opts[name] = value
            i += 2
            continue
        if arg in bool_flags:
            opts[bool_flags[arg]] = True
            i += 1
            continue
        if arg.startswith("--") and "=" in arg:
            name, value = arg.split("=", 1)
            if name in value_flags:
                key = value_flags[name]
                value = coerce(key, value)
                if key == "env":
                    opts.setdefault("env", []).append(value)
                else:
                    opts[key] = value
                i += 1
                continue
        opts["command_parts"].append(arg)
        i += 1
    return opts


def main():
    argv = sys.argv[1:]

    if argv and argv[0] in ("put", "get", "doctor", "ls", "stat", "read", "cat", "rm", "ps",
                            "session", "api", "write", "state", "timeline", "apps", "context",
                            "privacy", "history"):
        sub = argv[0]
        rest = argv[1:]
        server = None
        positional = []
        for arg in rest:
            if arg.startswith("--server="):
                server = arg.split("=", 1)[1]
            elif not arg.startswith("--"):
                positional.append(arg)

        if sub == "doctor":
            sys.exit(cmd_doctor(server=server))
        if sub in ("put", "write"):
            if len(positional) != 2:
                die("usage: winb put <local> <remote>")
            sys.exit(cmd_put(positional[0], positional[1], server=server))
        if sub == "get":
            if len(positional) != 2:
                die("usage: winb get <remote> <local>")
            sys.exit(cmd_get(positional[0], positional[1], server=server))
        if sub in ("read", "cat"):
            sys.exit(cmd_fs("read", rest, server=server))
        if sub in ("ls", "stat", "rm"):
            sys.exit(cmd_fs(sub, rest, server=server))
        if sub == "ps":
            sys.exit(cmd_ps(rest, server=server))
        if sub == "session":
            if not rest:
                sys.exit(cmd_session("list", [], server=server))
            sys.exit(cmd_session(rest[0], rest[1:], server=server))
        if sub == "api":
            if len(positional) < 2:
                die('usage: winb api <METHOD> <path> [json-body]')
            sys.exit(cmd_api(positional[0], positional[1], positional[2] if len(positional) > 2 else None,
                             server=server))
        if sub == "state":
            sys.exit(cmd_state(rest, server=server))
        if sub == "timeline":
            sys.exit(cmd_timeline(rest, server=server))
        if sub == "apps":
            sys.exit(cmd_apps(rest, server=server))
        if sub == "context":
            sys.exit(cmd_context(rest, server=server))
        if sub == "privacy":
            sys.exit(cmd_privacy(rest, server=server))
        if sub == "history":
            sys.exit(cmd_history(rest, server=server))

    opts = parse(argv)
    if opts.get("help"):
        print(HELP)
        sys.exit(0)

    server = opts.get("server", SERVER_URL)

    if opts.get("version"):
        try:
            server_version = json.loads(request("GET", "/health", timeout=8, server=server,
                                                retries=1)[1]).get("version", "?")
        except WinbError as exc:
            server_version = f"unreachable ({exc})"
        print(f"winb client 2.0.0 | server {server_version}")
        sys.exit(0)

    command = " ".join(opts["command_parts"]).strip()
    if opts.get("cmd_file"):
        try:
            with open(opts["cmd_file"], "r", encoding="utf-8") as fh:
                file_command = fh.read()
        except OSError as exc:
            die(f"cannot read --cmd-file: {exc}")
        command = file_command if not command else f"{file_command}\n{command}"

    env = {}
    for item in opts.get("env", []) or []:
        if "=" not in item:
            die(f"env must be KEY=VALUE: {item}")
        key, value = item.split("=", 1)
        env[key] = value

    stdin_bytes = None
    if opts.get("stdin_file"):
        try:
            with open(opts["stdin_file"], "rb") as fh:
                stdin_bytes = fh.read()
        except OSError as exc:
            die(f"cannot read --stdin-file: {exc}")
        if len(stdin_bytes) > STDIN_MAX:
            die(f"stdin payload is {len(stdin_bytes)} bytes, over the {STDIN_MAX} cap.\n"
                f"       Use `winb put <file> <remote-path>` (chunked, sha256 verified) instead.")

    timeout = int(opts.get("timeout", 0) or 0)

    if opts.get("admin"):
        if opts.get("background"):
            die("--admin cannot be combined with --background")
        if not command:
            die("a command is required")
        if not SSH_REMOTE:
            die("--admin needs WINB_SSH_TARGET (user@host) and WINB_SSH_KEY; "
                "without them there is no SSH route configured.")
        admin_run(command, opts.get("workdir") or SSH_DEFAULT_WORKDIR, stdin_bytes)

    # --- non-exec actions, v1-compatible text ---------------------------------
    if opts.get("kill"):
        status, text = request("POST", "/kill", {"processId": opts["kill"]}, server=server)
        payload = json.loads(text) if text else {}
        if "error" in payload:
            die(payload["error"])
        print()
        sys.exit(0)

    if opts.get("open_url"):
        status, text = request("POST", "/open-url", {"url": opts["open_url"]}, server=server)
        payload = json.loads(text) if text else {}
        if "error" in payload:
            die(payload["error"])
        print(f"Opened URL: {payload.get('url')} (status: {payload.get('status')})")
        sys.exit(0)

    if opts.get("port"):
        status, text = request("GET", f"/port/{opts['port']}", server=server, retries=1)
        payload = json.loads(text) if text else {}
        if "error" in payload:
            die(payload["error"])
        state = "LISTENING" if payload.get("listening") else "not listening"
        print(f"Port {payload.get('port')}: {state}")
        conns = payload.get("connections") or []
        if not conns:
            print("No TCP connections found.")
        for row in conns:
            name = row.get("processName") or "unknown"
            print(f"  - {row.get('state')} PID {row.get('pid')} {name} "
                  f"@ {row.get('localAddress')}:{row.get('localPort')}")
        sys.exit(0)

    if opts.get("list"):
        status, text = request("GET", "/list", server=server, retries=1)
        procs = (json.loads(text) if text else {}).get("processes") or []
        if not procs:
            print("No background process records.")
        else:
            print("Background Process Records:\n")
            for row in procs:
                print(f"  - {row.get('processId')} (PID: {row.get('pid')}, {row.get('status')}) "
                      f":: {row.get('command')}")
        sys.exit(0)

    if opts.get("manifest"):
        status, text = request("GET", "/manifest", server=server, retries=1)
        raise_for_status(status, text)
        print(json.dumps(json.loads(text), indent=2))
        sys.exit(0)

    if opts.get("health"):
        status, text = request("GET", "/health", server=server, retries=1)
        raise_for_status(status, text)
        info = json.loads(text)
        print(f"Winb Server: {str(info.get('status')).upper()}")
        print(f"Version: {info.get('version')}")
        print(f"HMR: {str(info.get('hmr')).lower()}")
        print(f"PID: {info.get('pid')}")
        print(f"Port: {info.get('port')}")
        print(f"Platform: {info.get('platform')}")
        print(f"Workdir: {info.get('workdir')}")
        print(f"Started: {info.get('startedAt')}")
        print(f"Now: {info.get('now')}")
        print(f"Uptime: {info.get('uptimeSeconds')}s")
        counts = info.get("processes") or {}
        print(f"Processes: {counts.get('records')} records, {counts.get('running')} running, "
              f"{counts.get('exited')} exited")
        sys.exit(0)

    if opts.get("logs"):
        tail = int(opts.get("tail", 80) or 80)
        status, text = request("GET", f"/logs/{opts['logs']}?tail={tail}", server=server, retries=1)
        payload = json.loads(text) if text else {}
        if "error" in payload:
            die(payload["error"])
        print(f"Process: {payload.get('processId')} (PID: {payload.get('pid')}, {payload.get('status')})")
        print(f"Command: {payload.get('command')}")
        print(f"Workdir: {payload.get('workdir')}")
        print("--- STDOUT ---")
        out = payload.get("stdout") or []
        print("(empty)" if not out else "\n".join(out))
        print("--- STDERR ---")
        err = payload.get("stderr") or []
        print("(empty)" if not err else "\n".join(err))
        sys.exit(0)

    # --- exec -----------------------------------------------------------------
    if not command:
        print("Error: Command is required.\n")
        print(HELP)
        sys.exit(1)

    result = run_remote(command, workdir=opts.get("workdir"),
                        powershell=opts.get("powershell", False), timeout=timeout, env=env,
                        stdin_bytes=stdin_bytes, background=opts.get("background", False),
                        process_id=opts.get("process_id"), client_timeout=opts.get("client_timeout"),
                        server=server, session=opts.get("session"))

    if opts.get("background"):
        if result.get("error"):
            die(result["error"])
        print(f"Started background process ID: {result.get('processId')} (PID: {result.get('pid')})")
        sys.exit(0)

    if result.get("error") and "stdout" not in result:
        err = str(result["error"])
        if "ENOENT" in err:
            workdir = opts.get("workdir") or "(server default)"
            die(f"spawn failed: {err}\n"
                f"       workdir '{workdir}' does not exist or is not usable on the PC.\n"
                f"       The server also crashes on this error and the watchdog respawns it in "
                f"~15-20 s; the next call will wait for it. Fix the path and retry.")
        die(f"server: {err}")

    sys.exit(render_exec(result, quiet=opts.get("quiet", False), out_path=opts.get("out"),
                         json_mode=opts.get("json", False), timeout_used=timeout))


if __name__ == "__main__":
    try:
        main()
    except WinbError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        die("interrupted", 130)
