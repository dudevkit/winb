def _parse_iso(iso):
    try:
        stamp = datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=datetime.timezone.utc)
    return stamp


def _ago(iso):
    """Compact age of an ISO timestamp, in the reader's timezone."""
    stamp = _parse_iso(iso)
    if stamp is None:
        return "?"
    delta = (datetime.datetime.now(datetime.timezone.utc) - stamp).total_seconds()
    if delta < 0:
        return "just now"
    if delta < 90:
        return f"{int(delta)}s ago"
    if delta < 5400:
        return f"{int(delta // 60)}m ago"
    if delta < 172800:
        return f"{delta / 3600:.1f}h ago"
    return f"{delta / 86400:.1f}d ago"


def _clock(iso):
    stamp = _parse_iso(iso)
    return stamp.astimezone().strftime("%m-%d %H:%M:%S") if stamp else (str(iso) if iso else "?")


def _servers_arg(args, server):
    for arg in args:
        if arg.startswith("--server="):
            return arg.split("=", 1)[1]
    return server


def _flag_value(args, name, default=None):
    for i, arg in enumerate(args):
        if arg == name and i + 1 < len(args):
            return args[i + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return default


def _event_detail(kind, data):
    if kind == "app.switch":
        detail = data.get("app", "?")
        if data.get("title"):
            detail += f'   "{data["title"][:70]}"'
        return detail
    if kind == "app.usage":
        return f"{data.get('app', '?')} for {data.get('sec', 0)}s"
    if kind == "res.sample":
        parts = []
        if data.get("memUsedMb"):
            parts.append(f"mem {data['memUsedMb']} MB")
        if data.get("procCount"):
            parts.append(f"{data['procCount']} procs")
        top = ", ".join(f"{t.get('name')} {t.get('cpuSec')}s" for t in (data.get("cpuTop") or [])[:3])
        if top:
            parts.append(f"top cpu: {top}")
        return " | ".join(parts) or "sample"
    if kind in ("power.boot", "power.shutdown"):
        detail = data.get("bootTime") or data.get("at") or ""
        if data.get("clean") is False:
            detail += "  UNEXPECTED SHUTDOWN"
        if data.get("actor"):
            detail += f"  by {str(data['actor'])[:50]}"
        return detail.strip() or "planner"
    if kind == "session.change":
        return f"{data.get('user') or '?'} {data.get('state')} (idle {data.get('idleSec')}s){' locked' if data.get('locked') else ''}"
    if kind == "disk.change":
        if data.get("appeared"):
            return f"{data.get('drive')} appeared: {data.get('freeGb')} GB free ({data.get('pct')}%)"
        if data.get("disappeared"):
            return f"{data.get('drive')} disappeared"
        return f"{data.get('drive')} below {data.get('threshold')}%: {data.get('freeGb')} GB free ({data.get('pct')}%)"
    if kind == "net.change":
        return " | ".join(f"{a.get('iface')} {a.get('state')} {a.get('address') or '-'}"
                          for a in (data.get("adapters") or [])) or "adapter set changed"
    if kind == "app.crash":
        return f"event {data.get('id')}: {str(data.get('msg') or '')[:70]}"
    if kind == "bridge.reload":
        return f"server v{data.get('version')} pid {data.get('pid')}"
    if kind == "sampler.state":
        return f"{data.get('state')} {data.get('reason') or ''}".strip()
    return json.dumps(data)[:110]


def cmd_state(args, server=None):
