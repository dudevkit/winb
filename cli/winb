class WinbError(Exception):
    pass


# ---------------------------------------------------------------- transport

def _token():
    for path in TOKEN_PATHS:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                value = fh.read().strip()
            if value:
                return value
        except OSError:
            continue
    return os.environ.get("WINB_TOKEN", "")


def _connect_failed(proc):
    """True when the request never reached the server (safe to replay).

    Connection refused (7) and the connect phase timing out (28 with 'Connection' in the curl
    message) both mean the TCP session never opened. A read timeout also exits 28 but says
    'Operation timed out' - that one reached the server and must never be replayed.
    """
    if proc.returncode == 7:
        return True
    if proc.returncode == 28:
        return "onnection" in (proc.stderr or b"").decode("utf-8", "replace")
    return False


def _curl(args, data=None, timeout=30, retries=0):
    argv = ["curl", "-sS", "--connect-timeout", "6", "--max-time", str(int(timeout))]
    if WINB_SOCKS:
        argv += ["--socks5-hostname", WINB_SOCKS]
    if retries:
        argv += ["--retry", str(retries), "--retry-connrefused"]
    proc = subprocess.run(argv + args, input=data, capture_output=True)
    return proc


def request(method, path, payload=None, timeout=30, server=None, retries=0):
    """JSON request to winb-server. Returns (status_code, body_text).

    retries>0 is only safe for idempotent GETs: replaying a POST /run could start
    the same command on the PC twice.
    """
    url = (server or SERVER_URL).rstrip("/") + path
    args = ["-X", method, "-H", "Content-Type: application/json"]
    token = _token()
    if token:
        args += ["-H", "Authorization: Bearer " + token]
    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        args += ["--data-binary", "@-"]
    args += ["-w", "\n%{http_code}", url]

    attempt = 0
    while True:
        proc = _curl(args, data=data, timeout=timeout, retries=0)
        if _connect_failed(proc):
            # The request never reached the server, so replaying is safe. This is also the recovery
            # path after winb-server crashes: the watchdog respawns it in ~15-20 s.
            if attempt < retries:
                attempt += 1
                time.sleep(7)
                continue
            err = (proc.stderr or b"").decode("utf-8", "replace").strip()
            if proc.returncode == 122:
                raise WinbError(f"connection failed: {err}")
            raise WinbError(
                f"cannot reach winb-server at {url} after {retries + 1} attempts :: {err or 'refused'}\n"
                f"       The PC is asleep/off, winb-server is down, or it just crashed and the "
                f"watchdog (15 s poll) has not respawned it yet. Check `winb --health` or wake the PC."
                + ("\n       Talking to 127.0.0.1 because no WINB_HOST/WINB_URL is set; export one "
                   "if the server runs on another host." if SERVER_URL_IS_DEFAULT else ""))
        break

    out = proc.stdout.decode("utf-8", "replace")
    if proc.returncode != 0:
        err = (proc.stderr or b"").decode("utf-8", "replace").strip()
        if proc.returncode in (28, 52):
            raise WinbError(
                f"no response from winb-server within {timeout}s :: {err or 'empty reply'}\n"
                f"       The command is probably still running on the PC (a spawned child can hold "
                f"stdout open). Check `winb -l`, then `winb -k <id>`.")
        raise WinbError(f"curl failed (exit {proc.returncode}) for {url} :: {err}")

    body, _, status = out.rpartition("\n")
    try:
        code = int(status)
    except ValueError:
        return 0, out
    return code, body


def raise_for_status(status, text):
    if status == 401:
        raise WinbError(
            "unauthorized: the server rejected the token.\n"
            "       The client reads WINB_TOKEN_FILE, ~/.winb-token, /etc/winb-token or "
            "WINB_TOKEN; the server reads .token next to server.js (or WINB_TOKEN_FILE / "
            "WINB_TOKEN). Both sides need the same value.")
    if status == 413:
        raise WinbError(
            "server refused the payload (413). The body limit is 64 mb by default "
            "(WINB_BODY_LIMIT_MB); use `winb put` for files larger than that.")


def run_remote(command, workdir=None, powershell=False, timeout=0, env=None,
               stdin_bytes=None, background=False, process_id=None,
               client_timeout=None, server=None, session=None):
    payload = {
        "cmdB64": base64.b64encode(command.encode("utf-8")).decode("ascii"),
        "powershell": bool(powershell),
        "timeout": int(timeout or 0),
        "env": env or {},
    }
    if session:
        payload["session"] = session
    if workdir:
        payload["workdir"] = workdir
    if stdin_bytes is not None:
        payload["stdinB64"] = base64.b64encode(stdin_bytes).decode("ascii")
    if background:
        payload["background"] = True
        if process_id:
            payload["processId"] = process_id

    limit = client_timeout or (int(timeout) + 15 if timeout else DEFAULT_CLIENT_TIMEOUT)
    status, text = request("POST", "/run", payload, timeout=limit, server=server, retries=3)
    raise_for_status(status, text)
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        raise WinbError(f"server returned non-JSON (HTTP {status}): {text[:300]}")


def py_helper(script, env_values, server=None, stdin_bytes=None, timeout=0):
    """Run a python one-liner on the PC with parameters passed as env vars.

    Interpolating Windows paths into the command string breaks as soon as the
    path is quoted; an env var travels inside the JSON body and is read back with
    os.environ, so no shell layer sees the value.
    """
    return run_remote(f'python -c "{script}"', env=env_values, server=server,
                      stdin_bytes=stdin_bytes, timeout=timeout)


# ---------------------------------------------------------------- rendering

def emit_stdout(text):
    """Write stdout as bytes so NUL and lone CR survive."""
    sys.stdout.buffer.write(text.encode("utf-8", "surrogateescape"))
    sys.stdout.buffer.flush()


def render_exec(result, quiet=False, out_path=None, json_mode=False, timeout_used=0):
    if json_mode:
        print(json.dumps(result))
        return 124 if result.get("status") == "timeout" else int(result.get("exitCode") or 0)

    stdout = result.get("stdout") or ""
    stderr = result.get("stderr") or ""

    if stdout:
        if out_path:
            with open(out_path, "wb") as fh:
                fh.write(stdout.encode("utf-8", "surrogateescape"))
            if not quiet:
                print(f"saved {os.path.getsize(out_path)} bytes -> {out_path}")
        else:
            emit_stdout(stdout)
    if stderr:
        sys.stderr.buffer.write(stderr.encode("utf-8", "surrogateescape"))
        sys.stderr.buffer.flush()

    if result.get("status") == "timeout":
        print(f"\n[timeout after {timeout_used or '?'}s]", file=sys.stderr)
        return 124

    code = int(result.get("exitCode") or 0)
    # v1 made "exit 0 with no output" indistinguishable from a swallowed result.
    if code == 0 and not stdout and not stderr and not quiet and not out_path:
        print("[no output]", file=sys.stderr)
    return code


def die(msg, code=1):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- ssh path

def default_remote_dir(server=None):
    """Directory used when a file verb gets no path: WINB_DEFAULT_CWD, else the
    server's own default (reported by /manifest), else the server's process cwd."""
    env = os.environ.get("WINB_DEFAULT_CWD")
    if env:
        return env
    try:
        body = request("GET", "/manifest", timeout=20, server=server, retries=1)[1]
        info = json.loads(body)
        cwd = info.get("defaultCwd") or (info.get("server") or {}).get("workdir")
        if cwd:
            return cwd
    except (WinbError, ValueError, AttributeError):
        pass
    return "."


def admin_run(command, workdir, stdin_bytes):
    if shutil.which("ssh") is None:
        die("ssh not available locally")
    full = command
    if workdir:
        full = f"Set-Location -LiteralPath '{workdir}'; {full}"
    encoded = base64.b64encode(full.encode("utf-8")).decode("ascii")
    remote_cmd = (f'powershell -NoProfile -Command "iex ([Text.Encoding]::UTF8.GetString('
                  f'[Convert]::FromBase64String(\'{encoded}\')))"')
    argv = ["ssh", "-i", SSH_KEY, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
            "-o", "ConnectTimeout=8", SSH_REMOTE, remote_cmd]
    proc = subprocess.run(argv, input=stdin_bytes or b"", capture_output=True)
    if proc.stdout:
        sys.stdout.buffer.write(proc.stdout)
        sys.stdout.buffer.flush()
    if proc.stderr:
        sys.stderr.buffer.write(proc.stderr)
        sys.stderr.buffer.flush()
    sys.exit(proc.returncode)


# ---------------------------------------------------------------- file transfer

def _q(value):
    """Percent-encode a query value without importing urllib (one import costs seconds here)."""
    safe = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~/\\:")
    out = []
    for ch in value:
        if ch in safe:
            out.append(ch)
        else:
            out.append("".join(f"%{b:02X}" for b in ch.encode("utf-8")))
    return "".join(out)


_FS_SUPPORT = {}


def fs_supported(server=None):
    """True when the server exposes the typed fs.* endpoints (v1.3+)."""
    key = server or SERVER_URL
    if key not in _FS_SUPPORT:
        try:
            status, text = request("GET", "/manifest", server=server, retries=1, timeout=20)
            caps = json.loads(text).get("capabilities", []) if status == 200 else []
            _FS_SUPPORT[key] = "fs.read" in caps
        except Exception:                              # noqa: BLE001 - old server, fall back
            _FS_SUPPORT[key] = False
    return _FS_SUPPORT[key]


def api_call(method, path, payload=None, server=None, timeout=120):
    status, text = request(method, path, payload, server=server, retries=1, timeout=timeout)
    if status == 404 and "Cannot" in text[:200]:
        raise WinbError(
            f"this server does not expose {path.split('?')[0]} - it predates v1.3.\n"
            f"       Raw commands, put/get and the job endpoints still work there; update the "
            f"server (api.js + server.js v1.3) to get the typed fs/proc/session surface.")
    raise_for_status(status, text)
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        raise WinbError(f"server returned non-JSON (HTTP {status}): {text[:200]}")


def cmd_api(method, path, body, server=None):
    payload = None
    if body:
        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            die(f"request body must be JSON: {body[:80]}")
    print(json.dumps(api_call(method.upper(), path, payload, server=server), indent=2))
    return 0


def session_target(positional):
    """Accept either `session set <id>` or `session set --session <id>` shapes."""
    opts = [a for a in positional if not a.startswith("-")]
    return opts


def cmd_session(action, args, server=None):
    parsed = {"env": []}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-w", "--workdir"):
            parsed["workdir"] = args[i + 1]
            i += 2
            continue
        if arg in ("-e", "--env"):
            parsed["env"].append(args[i + 1])
            i += 2
            continue
        if arg.startswith("--server="):
            server = arg.split("=", 1)[1]
            i += 1
            continue
        if arg.startswith("-"):
            i += 1
            continue
        parsed.setdefault("id", arg)
        i += 1

    sid = parsed.get("id")
    if action == "list":
        for row in api_call("GET", "/sessions", server=server).get("sessions", []):
            print(f"  {row['id']:20} {row.get('workdir') or '-'}  env={len(row.get('env') or {})}")
        return 0
    if not sid:
        die("usage: winb session set|show|rm <id> [-w DIR] [-e KEY=VALUE] | winb session list")

    if action in ("set", "create"):
        payload = {}
        if parsed.get("workdir"):
            payload["workdir"] = parsed["workdir"]
        env = {}
        for item in parsed["env"]:
            if "=" not in item:
                die(f"env must be KEY=VALUE: {item}")
            key, value = item.split("=", 1)
            env[key] = value
        if env:
            payload["env"] = env
        row = api_call("POST", "/session", {"id": sid, **payload}, server=server)
        print(f"session {row['id']}: workdir={row.get('workdir')} env={row.get('env')}")
        return 0
    if action == "show":
        row = api_call("GET", f"/session/{_q(sid)}", server=server)
        print(json.dumps(row, indent=2))
        return 0
    if action in ("rm", "delete"):
        print(api_call("DELETE", f"/session/{_q(sid)}", server=server))
        return 0
    die(f"unknown session action: {action} (set|show|rm|list)")


def cmd_fs(action, args, server=None):
    """ls / stat / read / rm helpers on top of the typed endpoints."""
    parsed = {"recursive": False}
    positional = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--recursive":
            parsed["recursive"] = True
            i += 1
            continue
        if arg.startswith("--server="):
            server = arg.split("=", 1)[1]
            i += 1
            continue
        if arg in ("--pattern", "--filter"):
            parsed["pattern"] = args[i + 1]
            i += 2
            continue
        if arg == "--out":
            parsed["out"] = args[i + 1]
            i += 2
            continue
        if arg.startswith("--"):
            i += 1
            continue
        positional.append(arg)
        i += 1

    target = positional[0] if positional else None

    if action == "ls":
        query = f"/fs/list?path={_q(target or default_remote_dir(server))}"
        if parsed.get("pattern"):
            query += f"&pattern={_q(parsed['pattern'])}"
        data = api_call("GET", query, server=server)
        if not data.get("entries"):
            print(f"[empty] {data.get('path')}")
            return 0
        print(f"{data['path']}  ({data['count']} entries)")
        for row in data["entries"]:
            kind = "dir " if row["type"] == "dir" else "file"
            size = "" if row["type"] == "dir" else str(row["size"])
            stamp = (row.get("mtime") or "")[:19].replace("T", " ")
            print(f"  {kind} {stamp:19} {size:>10}  {row['name']}")
        return 0

    if action == "stat":
        if not target:
            die("usage: winb stat <path>")
        print(json.dumps(api_call("GET", f"/fs/stat?path={_q(target)}&sha256=1", server=server), indent=2))
        return 0

    if action == "read":
        if not target:
            die("usage: winb read <path> [--out FILE]")
        stat = api_call("GET", f"/fs/stat?path={_q(target)}", server=server)
        if not stat.get("exists") or stat.get("type") != "file":
            die(f"not a readable file: {target} ({stat.get('error', stat.get('type'))})")
        total = stat["size"]
        sink = open(parsed["out"], "wb") if parsed.get("out") else sys.stdout.buffer
        if parsed.get("out"):
            print(f"reading {total} bytes -> {parsed['out']}")
        CHUNK_READ = 1_000_000
        offset = 0
        try:
            while offset < total:
                block = api_call(
                    "GET",
                    f"/fs/read?path={_q(target)}&offset={offset}&length={CHUNK_READ}&encoding=base64",
                    server=server, timeout=300)
                raw = base64.b64decode(block.get("content") or "")
                if not raw:
                    break
                sink.write(raw)
                offset += len(raw)
        finally:
            if parsed.get("out"):
                sink.close()
        return 0

    if action == "rm":
        if not target:
            die("usage: winb rm <path> [--recursive]")
        payload = {"path": target, "recursive": bool(parsed["recursive"])}
        print(json.dumps(api_call("POST", "/fs/rm", payload, server=server), indent=2))
        return 0

    die(f"unknown fs action: {action} (ls|stat|read|rm)")


def cmd_ps(args, server=None):
    filt = None
    limit = 40
    i = 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("--server="):
            server = arg.split("=", 1)[1]
        elif arg == "--limit":
            limit = int(args[i + 1]); i += 1
        elif not arg.startswith("-"):
            filt = arg
        i += 1
    query = f"/proc/list?limit={limit}" + (f"&filter={_q(filt)}" if filt else "")
    data = api_call("GET", query, server=server, timeout=180)
    print(f"{'PID':>8}  {'MEM MB':>8}  NAME")
    for row in data.get("processes", []):
        print(f"{row['pid']:>8}  {row.get('memMB') or 0:>8}  {row.get('name')}")
    print(f"{data.get('count')} matching processes")
    return 0


def remote_sha256(path, server=None):
    result = py_helper("import hashlib,os;print(hashlib.sha256(open(os.environ['WINB_PATH'],'rb')"
                       ".read()).hexdigest())", {"WINB_PATH": path}, server=server)
    return (result.get("stdout") or "").strip()


def put_typed(local, remote, server=None, chunk=CHUNK, quiet=False):
    size = os.path.getsize(local)
    digest = hashlib.sha256()
    with open(local, "rb") as fh:
        sent = 0
        first = True
        while True:
            block = fh.read(chunk)
            if not block:
                break
            digest.update(block)
            result = api_call("POST", "/fs/write", {
                "path": remote,
                "dataB64": base64.b64encode(block).decode("ascii"),
                "append": not first,
                "mkdirs": True
            }, server=server, timeout=300)
            sent += len(block)
            first = False
            if not quiet:
                sys.stderr.write(f"\r  {sent}/{size} bytes")
    stat = api_call("GET", f"/fs/stat?path={_q(remote)}&sha256=1", server=server)
    if size and stat.get("sha256") != digest.hexdigest():
        die(f"sha256 mismatch after upload: local {digest.hexdigest()[:16]} remote {(stat.get('sha256') or '?')[:16]}")
    if not quiet:
        sys.stderr.write("\r" + " " * 40 + "\r")
        print(f"put {size} bytes -> {remote} (sha256 {digest.hexdigest()[:16]} verified, typed fs)")
    return 0


def get_typed(remote, local, server=None, chunk=1_000_000, quiet=False):
    stat = api_call("GET", f"/fs/stat?path={_q(remote)}", server=server)
    if not stat.get("exists") or stat.get("type") != "file":
        die(f"remote file not readable: {remote} ({stat.get('error', stat.get('type'))})")
    total = stat["size"]
    digest = hashlib.sha256()
    tmp = local + ".winb-part"
    written = 0
    with open(tmp, "wb") as fh:
        offset = 0
        while offset < total:
            block = api_call("GET",
                             f"/fs/read?path={_q(remote)}&offset={offset}&length={chunk}&encoding=base64",
                             server=server, timeout=300)
            raw = base64.b64decode(block.get("content") or "")
            if not raw:
                break
            fh.write(raw)
            digest.update(raw)
            written += len(raw)
            offset += len(raw)
            if not quiet:
                sys.stderr.write(f"\r  {written}/{total} bytes")
    os.replace(tmp, local)
    remote_stat = api_call("GET", f"/fs/stat?path={_q(remote)}&sha256=1", server=server)
    if total and remote_stat.get("sha256") != digest.hexdigest():
        die(f"sha256 mismatch after download: local {digest.hexdigest()[:16]} remote {(remote_stat.get('sha256') or '?')[:16]}")
    if not quiet:
        sys.stderr.write("\r" + " " * 40 + "\r")
        print(f"get {written} bytes <- {remote} (sha256 {digest.hexdigest()[:16]} verified, typed fs)")
    return 0


def cmd_put(local, remote, server=None, chunk=CHUNK, quiet=False):
    if not os.path.isfile(local):
        die(f"local file not found: {local}")
    if fs_supported(server):
        return put_typed(local, remote, server=server, chunk=chunk, quiet=quiet)
    size = os.path.getsize(local)
    digest = hashlib.sha256()
    with open(local, "rb") as fh:
        sent = 0
        first = True
        while True:
            block = fh.read(chunk)
            if not block:
                break
            digest.update(block)
            helper = ("import sys,os,pathlib;"
                      "p=pathlib.Path(os.environ['WINB_PATH']);"
                      "p.parent.mkdir(parents=True, exist_ok=True);"
                      "open(p,os.environ['WINB_MODE']).write(sys.stdin.buffer.read())")
            result = py_helper(helper, {"WINB_PATH": remote, "WINB_MODE": "wb" if first else "ab"},
                               server=server, stdin_bytes=block)
            if result.get("status") == "timeout" or (result.get("exitCode") or 0) != 0:
                die(f"upload failed at offset {sent}: "
                    f"{(result.get('stderr') or result.get('error') or '').strip()[:200]}")
            sent += len(block)
            first = False
    local_hex = digest.hexdigest()
    if size:
        remote_hex = remote_sha256(remote, server=server)
        if remote_hex and remote_hex != local_hex:
            die(f"sha256 mismatch after upload: local {local_hex[:16]} remote {remote_hex[:16]}")
    if not quiet:
        print(f"put {size} bytes -> {remote} (sha256 {local_hex[:16]} verified)")
    return 0


def cmd_get(remote, local, server=None, chunk=500000, quiet=False):
    if fs_supported(server):
        return get_typed(remote, local, server=server, quiet=quiet)
    probe = py_helper("import os;print(os.path.getsize(os.environ['WINB_PATH']))",
                      {"WINB_PATH": remote}, server=server)
    if (probe.get("exitCode") or 0) != 0:
        die(f"remote file not readable: {remote}: {(probe.get('stderr') or '').strip()[:200]}")
    size = int((probe.get("stdout") or "0").strip() or 0)
    digest = hashlib.sha256()
    written = 0
    tmp = local + ".winb-part"
    with open(tmp, "wb") as fh:
        offset = 0
        while offset < size:
            helper = ("import base64,os,sys;"
                      "fh=open(os.environ['WINB_PATH'],'rb');"
                      "fh.seek(int(os.environ['WINB_OFFSET']));"
                      "sys.stdout.buffer.write(base64.b64encode(fh.read(int(os.environ['WINB_LEN']))))")
            result = run_remote(f'python -c "{helper}"', server=server, timeout=120,
                                env={"WINB_PATH": remote, "WINB_OFFSET": str(offset),
                                     "WINB_LEN": str(chunk)})
            if (result.get("exitCode") or 0) != 0:
                die(f"download failed at offset {offset}: {(result.get('stderr') or '')[:200]}")
            block = base64.b64decode((result.get("stdout") or "").strip())
            if not block:
                break
            fh.write(block)
            digest.update(block)
            written += len(block)
            offset += chunk
    os.replace(tmp, local)
    if size:
        remote_hex = remote_sha256(remote, server=server)
        if remote_hex and remote_hex != digest.hexdigest():
            die(f"sha256 mismatch after download: local {digest.hexdigest()[:16]} remote {remote_hex[:16]}")
    if not quiet:
        print(f"get {written} bytes <- {remote} (sha256 {digest.hexdigest()[:16]} verified)")
    return 0


