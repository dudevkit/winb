    host, power, session = data.get("host", {}), data.get("power", {}), data.get("session", {})
    res, apps, track = data.get("res", {}), data.get("apps", {}), data.get("tracking", {})
    mem = f"{res.get('memUsedMb')}/{host.get('memTotalMb')} MB" if res.get("memUsedMb") else "-"
    print(f"host      {host.get('name')}  {host.get('platform')}  {host.get('cpus')} cpu")
    print(f"power     boot {_clock(power.get('bootTime'))} ({_ago(power.get('bootTime'))}), uptime {power.get('uptimeSec', 0) / 3600:.1f} h")
    idle = session.get("idleSec")
    print(f"session   {session.get('user') or '-'}  {session.get('state')}"
          f"{'  locked' if session.get('locked') else ''}  idle {idle if idle is not None else '?'}s  {session.get('name') or '-'}")
    print(f"res       mem {mem}   procs {res.get('procCount') if res.get('procCount') else '-'}")
    if data.get("disk"):
        print("disk      " + " | ".join(f"{d.get('drive')} {d.get('freeGb')}G free ({d.get('pct')}%)" for d in data["disk"]))
    if data.get("net"):
        print("net       " + " | ".join(f"{n.get('iface')} {n.get('state')} {n.get('speedMbps')}Mbps {n.get('address') or '-'}" for n in data["net"]))
    active = apps.get("active")
    if active:
        print(f"apps      foreground {active.get('app')} ({active.get('durSec', 0) / 60:.1f} min)"
              + (f'  "{active.get("title")}"' if active.get("title") else ""))
    if res.get("cpuTop"):
        print("cpu top   " + " | ".join(f"{t.get('name')} {t.get('cpuSec')}s ({t.get('wsMb')} MB)" for t in res["cpuTop"]))
    print(f"tracking  {'on' if track.get('enabled') and track.get('sampling') else 'off'}"
          f"  titles {'on' if track.get('titles') else 'off'}"
          f"{' (live-only)' if track.get('titles') and not track.get('titlesPersist') else ''}"
