#!/usr/bin/env -S python3 -S
"""winb v2 - client for the winb-server bridge (Linux gateway side).

Rewritten from the bash + jq v1 for three reasons:

  1. Latency. v1 spawned jq six times per call, ~2.7 s of pure overhead on this
     gateway. v2 is one interpreter with the JSON body piped straight into curl,
     so a round trip costs ~0.2 s instead of ~2.8 s.
  2. Quoting. The command always travels as base64 inside a JSON body, so no
     shell (bash, cmd.exe, PowerShell) re-parses it on the way out. `--cmd-file`
     removes local shell quoting entirely.
  3. Silent failures. stdout is written as bytes (NUL and lone CR survive), and
     every failure path prints a reason instead of an empty success.

`-S` in the shebang skips site initialisation; this client is stdlib only and
importing urllib alone cost more than the whole request did.

Flags, text output format and exit codes stay compatible with v1 (remote exit
code, 124 on timeout, 1 on transport error). One intentional difference: v1
stripped trailing newlines through bash command substitution, v2 preserves the
remote bytes exactly.
"""

import base64
import datetime
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

def _default_server_url():
    """WINB_URL wins, then WINB_HOST/WINB_PORT, then loopback.

    Loopback is the default because the usual deployment keeps the server on the
    Windows box and reaches it through a tunnel or a port-forward. Point it at the
    LAN address with WINB_HOST (or WINB_URL) when the gateway talks to it directly.
    """
    if os.environ.get("WINB_URL"):
        return os.environ["WINB_URL"]
    host = os.environ.get("WINB_HOST", "127.0.0.1")
    port = os.environ.get("WINB_PORT", "5110")
    return f"http://{host}:{port}"


SERVER_URL = os.environ.get("WINB_SERVER_URL") or _default_server_url()
SERVER_URL_IS_DEFAULT = not any(os.environ.get(k) for k in
                                ("WINB_URL", "WINB_SERVER_URL", "WINB_HOST"))
WINB_SOCKS = os.environ.get("WINB_SOCKS", "")          # e.g. socks5h://127.0.0.1:1055
TOKEN_PATHS = tuple(x for x in (os.environ.get("WINB_TOKEN_FILE"),
                               os.path.expanduser("~/.winb-token"),
                               "/etc/winb-token") if x)
SSH_KEY = os.environ.get("WINB_SSH_KEY", os.path.expanduser("~/.ssh/winb-admin"))
SSH_REMOTE = os.environ.get("WINB_SSH_TARGET", "")     # user@host; empty disables --admin
SSH_DEFAULT_WORKDIR = os.environ.get("WINB_DEFAULT_CWD", "")
STDIN_MAX = 40_000_000      # raw bytes per --stdin-file; server body limit is 64 mb (base64 inflates 4/3)
DEFAULT_CLIENT_TIMEOUT = 1800
CHUNK = 1_000_000           # put/get chunk size

