def cmd_doctor(server=None):
    rows = []

    def probe(label, fn):
        start = time.time()
        try:
            value = fn()
        except Exception as exc:                      # noqa: BLE001 - report, never crash
            value = f"ERROR: {exc}"
        rows.append((label, round(time.time() - start, 2), str(value).strip()))

    probe("server version", lambda: json.loads(request("GET", "/health", timeout=10,
                                                       server=server, retries=1)[1])["version"])
    probe("auth + manifest", lambda: (
        lambda m: f"host={m['host']} auth={m['authRequired']} body={m['limits']['bodyMB']}mb"
    )(json.loads(request("GET", "/manifest", timeout=30, server=server, retries=1)[1])))
    probe("echo round trip", lambda: run_remote("echo winb", server=server)["stdout"].strip())
    probe("powershell round trip", lambda: run_remote("Write-Output winb", powershell=True,
                                                      server=server)["stdout"].strip())
    probe("utf8 probe U+2713", lambda: run_remote("[Console]::Out.Write([char]0x2713)", powershell=True,
                                                  server=server)["stdout"].encode("utf-8").hex())
    probe("default cwd", lambda: run_remote("cd", server=server)["stdout"].strip())
    probe("python on PC", lambda: (run_remote("python -V", server=server).get("stdout")
                                   or run_remote("python -V", server=server).get("stderr") or "").strip())
    probe("node on PC", lambda: run_remote("node --version", server=server)["stdout"].strip())
    probe("git on PC", lambda: run_remote("git --version", server=server)["stdout"].strip())
    probe("drives", lambda: " | ".join(
        f"{d['name']} {d.get('freeGB', '?')}G free"
        for d in json.loads(request("GET", "/manifest", timeout=30, server=server,
                                    retries=1)[1]).get("drives", [])) or "none reported")
    # Set WINB_SHARE_MOUNT to the path where this gateway mounts the host's share; the
    # transport report is skipped when it is unset (the mount is optional by design).
    if os.environ.get("WINB_SHARE_MOUNT"):
        mount = os.environ["WINB_SHARE_MOUNT"]
        probe("share mount", lambda: subprocess.run(
            ["findmnt", "-no", "OPTIONS", mount], capture_output=True,
            text=True).stdout.strip() or f"NOT MOUNTED ({mount})")
    probe("client", lambda: f"winb v2 python {sys.version.split()[0]}")

    width = max(len(r[0]) for r in rows)
    print(f"{'check'.ljust(width)}  {'secs':>6}  result")
    print("-" * (width + 50))
    for label, secs, value in rows:
        print(f"{label.ljust(width)}  {secs:>6}  {value}")
    return 1 if any("ERROR" in r[2] for r in rows) else 0


