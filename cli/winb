def cmd_context(args, server=None):
    """Delta since this gateway last looked, plus what is running there."""
    server = _servers_arg(args, server)
    as_json = "--json" in args
    hours = _flag_value(args, "--hours", 24)
    cursor = ""
    try:
        with open(CURSOR_FILE, "r", encoding="utf-8") as fh:
            cursor = fh.read().strip()
    except OSError:
        cursor = ""
    since = api_call("GET", "/events/since" + (f"?cursor={cursor}" if cursor else ""), server=server, timeout=60)
    events = since.get("events", [])
    keep = [e for e in events if (_parse_iso(e.get("t")) or datetime.datetime.now(datetime.timezone.utc))
            >= datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=float(hours))]
    jobs = []
    try:
        jobs = api_call("GET", "/list", server=server, timeout=30).get("processes", [])
    except WinbError:
        jobs = []
    running = [j for j in jobs if j.get("status") == "running"]
    state = {}
    try:
        state = api_call("GET", "/state", server=server, timeout=30)
    except WinbError:
        state = {}
    if as_json:
        print(json.dumps({"newEvents": len(keep), "events": keep, "runningJobs": running,
                          "session": (state.get("session") or {}), "cursor": since.get("cursor")}, indent=2))
    else:
        if since.get("baseline"):
            print("first call from this gateway: baseline recorded, nothing to report yet")
        elif since.get("reset"):
            print("history was rotated or purged since the last call: cursor re-baselined")
        else:
            print(f"{len(keep)} new event(s) since this gateway last looked"
                  + (f", {len(events) - len(keep)} older than {hours}h" if len(events) > len(keep) else ""))
            for event in sorted(keep, key=lambda e: e.get("t") or ""):
                print("  " + f"{_clock(event.get('t'))}  {event.get('kind'):<18} {_event_detail(event.get('kind'), event.get('data') or {})}")
            if not keep:
                print("  host was quiet: no state changes recorded")
        session = state.get("session") or {}
        idle = session.get("idleSec")
        print(f"session   {session.get('state', '?')}  idle {idle if idle is not None else '?'}s"
              f"{'  locked' if session.get('locked') else ''}")
        print(f"jobs      {len(running)} running" + (": " + ", ".join(j.get('processId', '?') for j in running) if running else ""))
    try:
        with open(CURSOR_FILE, "w", encoding="utf-8") as fh:
            fh.write(since.get("cursor") or "")
        os.chmod(CURSOR_FILE, 0o600)
    except OSError as exc:
        print(f"warning: could not save cursor to {CURSOR_FILE}: {exc}", file=sys.stderr)
    return 0


