#!/bin/bash
# winb-office: drive a remote Windows PC reachable only through a reverse tunnel.
#
# Thin wrapper around the shared client. The old bash+jq version spawned jq six times
# per call (~2.7 s of overhead); the shared client does a round trip in ~0.33 s and
# fixes the quoting, stdin, NUL-byte and hang classes.
#
# Transport: the remote PC holds a reverse SSH tunnel to a bastion host, and a small
# systemd bridge on the gateway forwards 127.0.0.1:5110 into it, so the client just
# talks to loopback. The loopback bridge is the security boundary - never expose the
# bastion port publicly. Point WINB_SERVER_URL elsewhere if you run it differently.
#
# Deliberately different from the home `winb`:
#   - no --admin route: the office PC only offers a reverse tunnel (no inbound shell),
#     so this wrapper refuses --admin instead of silently trying to SSH there.
#   - a preflight /ping so an offline PC fails loudly instead of looking like an
#     empty success, plus a raw --ping check.
#   - the office server may still be v1.2: the shared client degrades to its
#     exec/put/get path when the typed fs endpoints are missing.

export WINB_SERVER_URL="${WINB_SERVER_URL:-http://127.0.0.1:5110}"
WINB_CLIENT="${WINB_CLIENT:-winb}"

bridge_hint() {
    echo "       Either the office PC is off / not connected to the tunnel," >&2
    echo "       or winb-office-bridge.service is down on this gateway." >&2
    echo "       Check: systemctl status winb-office-bridge" >&2
    echo "       The bastion's forwarded port should be LISTENING only while the PC is up." >&2
}

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            cat <<'HELP'
Usage: winb-office [OPTIONS] "command"

Runs a command on the Office Windows PC through the loopback bridge (v2 client).

Transport
  -w, --workdir <dir>      working directory on the office PC
  -p, --powershell         run through powershell.exe instead of cmd.exe
  -t, --timeout <sec>      server-side timeout (kills the process tree)
  -e, --env KEY=VALUE      extra environment variable (repeatable)

Payload
  --stdin-file <path>      feed this file to the remote command's stdin
  --cmd-file <path>        read the command from a file (no shell quoting)

Output
  --json                   raw server response
  --out <path>             save stdout to a local file

Jobs and info
  -b, --background         start detached
  -id, --process-id <id>   name for the background process
  -l, --list               list background records
  --logs <id> [--tail N]   show background logs
  -k, --kill <id>          kill a background process (tree)
  --health                 server health
  --ping                   raw connectivity check against the bridge
  --port <port>            check a TCP port on the office PC
  --open-url <url>         open a URL in the office PC's browser
  --manifest               device facts (needs server v1.3+)
  --version                versions
  -h, --help               this help

Files / typed ops (v2 client, needs server v1.3+ for the typed endpoints)
  put <local> <remote>     chunked upload, sha256 verified
  get <remote> <local>     chunked download, sha256 verified
  ls | stat | read | rm | ps | session | api

NOT available here: --admin (the office PC offers no inbound SSH; elevate on that
machine itself instead).
HELP
            exit 0
            ;;
        --admin)
            echo "Error: --admin is not available for the office PC (reverse tunnel only)." >&2
            echo "       Elevate a process on that machine directly instead." >&2
            exit 1
            ;;
    esac
done

if ! curl -s --max-time 15 -o /dev/null "${WINB_SERVER_URL}/ping"; then
    echo "Error: office PC not reachable via ${WINB_SERVER_URL}" >&2
    bridge_hint
    exit 1
fi

# Raw connectivity check (kept from the v1 wrapper).
if [[ "$1" == "--ping" ]]; then
    curl -s --max-time 15 "${WINB_SERVER_URL}/ping"
    echo ""
    exit 0
fi

exec "$WINB_CLIENT" "$@"
